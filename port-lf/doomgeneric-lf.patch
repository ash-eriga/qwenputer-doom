index 23f6ff3..9a1492d 100644
--- a/doomgeneric/m_fixed.c
+++ b/doomgeneric/m_fixed.c
@@ -27,9 +27,9 @@
 
 
 
-
 // Fixme. __USE_C_FIXED__ or something.
 
+#ifndef LF_FIXED_ASM
 fixed_t
 FixedMul
 ( fixed_t	a,
@@ -37,6 +37,7 @@ FixedMul
 {
     return ((int64_t) a * (int64_t) b) >> FRACBITS;
 }
+#endif
 
 
 
@@ -52,11 +53,28 @@ fixed_t FixedDiv(fixed_t a, fixed_t b)
     }
     else
     {
-	int64_t result;
-
-	result = ((int64_t) a << 16) / b;
-
-	return (fixed_t) result;
+	// Port change: the renderer calls this a few dozen times per frame (R_ScaleFromGlobalAngle,
+	// SlopeDiv, P_*).  The 64-bit division below becomes __divdi3, a software loop of a hundred
+	// instructions that the LX machine pays a token for every step of.  When |a| < 2^15 the
+	// shift cannot overflow a 32-bit int, so the hardware 32-bit divider gives the identical
+	// quotient -- and both operands of a wall projection are in that range in practice.
+	//
+	// Measured, so not obvious: the remaining wide case does NOT want hand-written assembly.
+	// An exact RV32IM version of it (two hardware divides to split off the integer part, then
+	// 16 shift-subtract steps for the 16 fraction bits, pixel-identical on frames 6/10/60/150)
+	// costs 165 tokens per call where libgcc's __divdi3 -- which normalizes the operands first
+	// and leaves its loop early -- costs 100, i.e. 5.8k more tokens per frame.  libgcc stays.
+	if (a > -0x8000 && a < 0x8000)
+	{
+	    return (fixed_t) (((int32_t) a << 16) / b);
+	}
+	else
+	{
+	    int64_t result;
+
+	    result = ((int64_t) a << 16) / b;
+
+	    return (fixed_t) result;
+	}
     }
 }
-
diff --git a/doomgeneric/m_fixed.h b/doomgeneric/m_fixed.h
index 733b290..2513e99 100644
--- a/doomgeneric/m_fixed.h
+++ b/doomgeneric/m_fixed.h
@@ -31,7 +31,25 @@
 
 typedef int fixed_t;
 
+#ifdef LF_FIXED_ASM
+// FixedMul is a leaf the renderer calls a few dozen times per column and span. Inlining the
+// RV32M multiply (see m_fixed.c) removes the call and return records the LX machine pays for,
+// and lets gcc fold the surrounding shift. Definition lives here, not in m_fixed.c, for that
+// reason; -DLF_FIXED_ASM is only set by port-lf/build_fast.sh.
+#include <stdint.h>
+static inline __attribute__((always_inline))
+fixed_t FixedMul (fixed_t a, fixed_t b)
+{
+    uint32_t lo, hi;
+    __asm__ ("mul  %0, %2, %3\n\t"
+             "mulh %1, %2, %3"
+             : "=&r" (lo), "=&r" (hi)
+             : "r" ((uint32_t) a), "r" ((uint32_t) b));
+    return (fixed_t) ((lo >> FRACBITS) | (hi << (32 - FRACBITS)));
+}
+#else
 fixed_t FixedMul	(fixed_t a, fixed_t b);
+#endif
 fixed_t FixedDiv	(fixed_t a, fixed_t b);
 
 
