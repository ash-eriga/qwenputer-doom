+static unsigned long long *lumpkey;   // W_LumpNameKey of each lump, built with the hash table
 
 // Hash function used for lump names.
 
+// Case-folded 8-byte key for a lump name. Lump names are ASCII and at most 8 characters, NUL
+// padded, so a folded 64-bit word compares them exactly like strncasecmp(name, other, 8) -- and
+// on this machine an integer compare is ~60x cheaper than the call into strncasecmp/toupper.
+unsigned long long W_LumpNameKey(const char *s)
+{
+    unsigned long long k = 0;
+
+    for (unsigned int i = 0; i < 8; ++i)
+    {
+        unsigned char c = (unsigned char) s[i];
+
+        if (c == '\0')
+            break;
+        if (c >= 'a' && c <= 'z')
+            c -= 'a' - 'A';
+        k |= (unsigned long long) c << (8 * i);
+    }
+
+    return k;
+}
